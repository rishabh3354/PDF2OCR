[Desktop Entry]
Version=1.0
Type=Application
Name=PDF2OCR
GenericName=OCR Text Extractor
Comment=Turn scanned PDFs, images and screenshots into editable text (offline)
Icon=pdf2go.png
Exec=pdf2go %F
Terminal=false
Categories=Office;Scanning;OCR;Qt;
Keywords=ocr;pdf;scan;text;tesseract;image;screenshot;extract;
MimeType=application/pdf;image/png;image/jpeg;image/tiff;image/bmp;image/gif;image/webp;
Actions=Capture;

[Desktop Action Capture]
Name=Capture Text from Screen
Exec=pdf2go --capture
